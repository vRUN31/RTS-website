NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SMTP Configuration for Email Notifications
# Required for sending driver assignment emails
# Example configurations below:

# For Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password (NOT your regular password - use App Password)

# For Outlook/Hotmail:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password

# For Custom SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: Customize sender name and email
SMTP_FROM_NAME=Rajmohan Transport Services
SMTP_FROM_EMAIL=

# Site URL (for links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


