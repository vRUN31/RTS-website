# Example environment variables for local development
# Copy this file to .env.local and fill values before running

# Supabase (only the anon key should be used in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Admin email gating (comma-separated domains or emails)
# Example: NEXT_PUBLIC_ADMIN_EMAIL_DOMAINS=company.com,partner.org
NEXT_PUBLIC_ADMIN_EMAIL_DOMAINS=example.com
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# Optional: Next.js dev port (default 3000). If occupied, dev server will pick another port.
NEXT_PUBLIC_DEV_PORT=3000
